{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "watchPatterns": [
      "/app/**",
      "/bootstrap/**",
      "/config/**",
      "/database/**",
      "/docker/**",
      "/public/**",
      "/resources/**",
      "/routes/**",
      "/composer.json",
      "/composer.lock",
      "/package.json",
      "/package-lock.json",
      "/vite.config.js",
      "/Dockerfile",
      "/railway.json"
    ]
  },
  "deploy": {
    "healthcheckPath": "/health/live",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
